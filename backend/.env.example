NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# Database (Supabase PostgreSQL)
DATABASE_URL=
DIRECT_URL=

# JWT
JWT_ACCESS_SECRET=
JWT_ISSUER=placementhub
JWT_AUDIENCE=placementhub
JWT_ACCESS_TTL=15m

# Refresh token
REFRESH_TOKEN_TTL_DAYS=7

# Recruiter onboarding
RECRUITER_SIGNUP_CODE=

# Rate limiting (optional)
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100
GEMINI_API_KEY=
GEMINI_MODEL=
# Used automatically when GEMINI_MODEL returns 503/429 (defaults to gemini-2.5-flash)
GEMINI_FALLBACK_MODEL=

# GitHub verification (all optional). Without a token GitHub allows only 60 requests/hour,
# roughly one verification, so set one in production. Use a token with
# public read-only access and never expose it to the client.
GITHUB_TOKEN=
GITHUB_TIMEOUT_MS=10000
GITHUB_MAX_REQUESTS=150
GITHUB_MAX_REPOS=6
GITHUB_MAX_FILES_PER_REPO=12
GITHUB_MAX_FILE_BYTES=100000