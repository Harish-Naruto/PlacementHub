NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# Database (Supabase PostgreSQL)
DATABASE_URL=
DIRECT_URL=

# JWT
JWT_ACCESS_SECRET=
JWT_ISSUER=placementhub
JWT_AUDIENCE=placementhub
JWT_ACCESS_TTL=15m

# Refresh token
REFRESH_TOKEN_TTL_DAYS=7

# Recruiter onboarding
RECRUITER_SIGNUP_CODE=

# Rate limiting (optional)
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100
GEMINI_API_KEY=
GEMINI_MODEL=
# Used automatically when GEMINI_MODEL returns 503/429 (defaults to gemini-2.5-flash)
GEMINI_FALLBACK_MODEL=
