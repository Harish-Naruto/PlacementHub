generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id @default(uuid()) @db.Uuid
  email             String             @unique @db.VarChar(320)
  name              String?            @db.VarChar(160)
  role              UserRole           @default(STUDENT)
  profileImage      String?            @db.VarChar(2048)
  createdAt         DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(6)
  passwordHash      String             @db.VarChar(255)
  applicationEvents ApplicationEvent[] @relation("ApplicationEventActor")
  companiesCreated  Company[]          @relation("CompanyCreator")
  recruiterProfile  RecruiterProfile?
  parsedResumes     ParsedResume[]
  studentProfile    StudentProfile?
  authSessions      AuthSession[]

  @@index([role])
}

// Refresh-token sessions for JWT-based authentication.
// Stores only the SHA-256 hash of the opaque refresh token.
model AuthSession {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  tokenHash   String    @unique @db.VarChar(64)
  tokenFamily String    @db.Uuid
  expiresAt   DateTime  @db.Timestamptz(6)
  revokedAt   DateTime? @db.Timestamptz(6)
  lastUsedAt  DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenFamily])
}

model Institution {
  id        String           @id @default(uuid()) @db.Uuid
  name      String           @db.VarChar(200)
  slug      String           @unique @db.VarChar(220)
  website   String?          @db.VarChar(2048)
  city      String?          @db.VarChar(120)
  state     String?          @db.VarChar(120)
  country   String           @default("India") @db.VarChar(100)
  createdAt DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @db.Timestamptz(6)
  students  StudentProfile[]

  @@index([name])
  @@index([city, state])
}

model StudentProfile {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @unique @db.Uuid
  institutionId  String?        @db.Uuid
  branch         String?        @db.VarChar(120)
  degree         String?        @db.VarChar(120)
  graduationYear Int?
  cgpa           Decimal?       @db.Decimal(4, 2)
  githubUsername String?        @db.VarChar(39)
  linkedinUrl    String?        @db.VarChar(2048)
  bio            String?        @db.VarChar(1000)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)
  applications   Application[]
  projects       Project[]
  institution    Institution?   @relation(fields: [institutionId], references: [id])
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills         StudentSkill[]

  @@index([institutionId, graduationYear])
  @@index([institutionId, branch])
}

model RecruiterProfile {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @unique @db.Uuid
  companyId String       @db.Uuid
  jobTitle  String?      @db.VarChar(120)
  createdAt DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @db.Timestamptz(6)
  jobs      JobPosting[]
  company   Company      @relation(fields: [companyId], references: [id])
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Company {
  id          String             @id @default(uuid()) @db.Uuid
  name        String             @db.VarChar(200)
  slug        String             @unique @db.VarChar(220)
  website     String?            @db.VarChar(2048)
  description String?
  city        String?            @db.VarChar(120)
  country     String?            @db.VarChar(100)
  createdById String             @db.Uuid
  createdAt   DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(6)
  createdBy   User               @relation("CompanyCreator", fields: [createdById], references: [id])
  recruiters  RecruiterProfile[]

  @@index([name])
}

model JobPosting {
  id                  String                      @id @default(uuid()) @db.Uuid
  recruiterProfileId  String                      @db.Uuid
  title               String                      @db.VarChar(200)
  description         String
  location            String?                     @db.VarChar(200)
  workMode            WorkMode                    @default(ONSITE)
  employmentType      EmploymentType              @default(FULL_TIME)
  minimumCgpa         Decimal?                    @db.Decimal(4, 2)
  applicationDeadline DateTime?                   @db.Timestamptz(6)
  externalUrl         String?                     @db.VarChar(2048)
  status              JobStatus                   @default(DRAFT)
  createdAt           DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime                    @updatedAt @db.Timestamptz(6)
  applications        Application[]
  eligibleBranches    JobEligibleBranch[]
  graduationYears     JobEligibleGraduationYear[]
  recruiterProfile    RecruiterProfile            @relation(fields: [recruiterProfileId], references: [id])
  skillRequirements   JobSkillRequirement[]
  sources             JobSource[]

  @@index([status, applicationDeadline])
  @@index([recruiterProfileId, status])
  @@index([createdAt])
}

model JobEligibleBranch {
  jobPostingId String     @db.Uuid
  branch       String     @db.VarChar(120)
  jobPosting   JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)

  @@id([jobPostingId, branch])
  @@index([branch])
}

model JobEligibleGraduationYear {
  jobPostingId   String     @db.Uuid
  graduationYear Int
  jobPosting     JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)

  @@id([jobPostingId, graduationYear])
  @@index([graduationYear])
}

model JobSkillRequirement {
  jobPostingId    String             @db.Uuid
  skillId         String             @db.Uuid
  requirementType JobRequirementType
  weight          Decimal            @default(1.0) @db.Decimal(5, 2)
  jobPosting      JobPosting         @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  skill           Skill              @relation(fields: [skillId], references: [id])

  @@id([jobPostingId, skillId])
  @@index([skillId, requirementType])
}

model JobSource {
  id           String        @id @default(uuid()) @db.Uuid
  jobPostingId String        @db.Uuid
  sourceType   JobSourceType
  sourceUrl    String?       @db.VarChar(2048)
  externalId   String?       @db.VarChar(255)
  fingerprint  String?       @unique @db.VarChar(255)
  importedAt   DateTime      @default(now()) @db.Timestamptz(6)
  jobPosting   JobPosting    @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)

  @@index([jobPostingId])
  @@index([sourceType, externalId])
}

model Skill {
  id              String                @id @default(uuid()) @db.Uuid
  name            String                @unique @db.VarChar(120)
  category        String?               @db.VarChar(100)
  createdAt       DateTime              @default(now()) @db.Timestamptz(6)
  jobRequirements JobSkillRequirement[]
  projectSkills   ProjectSkill[]
  aliases         SkillAlias[]
  studentSkills   StudentSkill[]

  @@index([category])
}

model SkillAlias {
  id      String @id @default(uuid()) @db.Uuid
  alias   String @unique @db.VarChar(120)
  skillId String @db.Uuid
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([skillId])
}

model StudentSkill {
  id                 String                  @id @default(uuid()) @db.Uuid
  studentProfileId   String                  @db.Uuid
  skillId            String                  @db.Uuid
  declaredLevel      ProficiencyLevel?
  verificationStatus SkillVerificationStatus @default(SELF_DECLARED)
  createdAt          DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                @updatedAt @db.Timestamptz(6)
  evidence           SkillEvidence[]
  skill              Skill                   @relation(fields: [skillId], references: [id])
  studentProfile     StudentProfile          @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, skillId])
  @@index([skillId, verificationStatus])
}

model Project {
  id                   String          @id @default(uuid()) @db.Uuid
  studentProfileId     String          @db.Uuid
  title                String          @db.VarChar(200)
  description          String
  personalContribution String?
  repositoryUrl        String?         @db.VarChar(2048)
  demoUrl              String?         @db.VarChar(2048)
  status               ProjectStatus   @default(DRAFT)
  submittedAt          DateTime?       @db.Timestamptz(6)
  createdAt            DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime        @updatedAt @db.Timestamptz(6)
  studentProfile       StudentProfile  @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  skills               ProjectSkill[]
  evidence             SkillEvidence[]

  @@index([studentProfileId, status])
  @@index([createdAt])
}

model ProjectSkill {
  projectId String  @db.Uuid
  skillId   String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill     Skill   @relation(fields: [skillId], references: [id])

  @@id([projectId, skillId])
  @@index([skillId])
}

model SkillEvidence {
  id             String             @id @default(uuid()) @db.Uuid
  studentSkillId String             @db.Uuid
  projectId      String?            @db.Uuid
  sourceType     EvidenceSourceType
  sourceUrl      String?            @db.VarChar(2048)
  description    String?
  status         EvidenceStatus     @default(PENDING)
  createdAt      DateTime           @default(now()) @db.Timestamptz(6)
  reviewedAt     DateTime?          @db.Timestamptz(6)
  project        Project?           @relation(fields: [projectId], references: [id])
  studentSkill   StudentSkill       @relation(fields: [studentSkillId], references: [id], onDelete: Cascade)

  @@index([studentSkillId, status])
  @@index([projectId])
}

model Application {
  id               String             @id @default(uuid()) @db.Uuid
  studentProfileId String             @db.Uuid
  jobPostingId     String             @db.Uuid
  resumeUrl        String?            @db.VarChar(2048)
  status           ApplicationStatus  @default(APPLIED)
  appliedAt        DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(6)
  jobPosting       JobPosting         @relation(fields: [jobPostingId], references: [id])
  studentProfile   StudentProfile     @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  events           ApplicationEvent[]

  @@unique([studentProfileId, jobPostingId])
  @@index([studentProfileId, status])
  @@index([jobPostingId, status])
  @@index([appliedAt])
}

model ApplicationEvent {
  id            String             @id @default(uuid()) @db.Uuid
  applicationId String             @db.Uuid
  actorUserId   String             @db.Uuid
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  note          String?            @db.VarChar(1000)
  createdAt     DateTime           @default(now()) @db.Timestamptz(6)
  actor         User               @relation("ApplicationEventActor", fields: [actorUserId], references: [id])
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@index([actorUserId, createdAt])
}

enum UserRole {
  STUDENT
  RECRUITER
}

enum ProficiencyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum SkillVerificationStatus {
  SELF_DECLARED
  REPOSITORY_OBSERVED
  EVALUATED
  NEEDS_REVIEW
}

enum ProjectStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  EVALUATED
  NEEDS_CHANGES
}

enum EvidenceSourceType {
  PROJECT
  GITHUB_REPOSITORY
  ASSESSMENT
  CERTIFICATE
  OTHER
}

enum EvidenceStatus {
  PENDING
  OBSERVED
  EVALUATED
  REJECTED
}

enum EmploymentType {
  FULL_TIME
  INTERNSHIP
  CONTRACT
  PART_TIME
}

enum WorkMode {
  ONSITE
  HYBRID
  REMOTE
}

enum JobStatus {
  DRAFT
  PUBLISHED
  PAUSED
  CLOSED
}

enum JobRequirementType {
  REQUIRED
  PREFERRED
}

enum JobSourceType {
  RECRUITER_POSTED
  PARTNER_POSTING
  ALUMNI_REFERRAL
  JOB_API
  OTHER
}

enum ApplicationStatus {
  APPLIED
  IN_REVIEW
  SHORTLISTED
  INTERVIEW_SCHEDULED
  INTERVIEWING
  OFFERED
  HIRED
  REJECTED
  WITHDRAWN
}


// -----------------------------------------------------------------------------
// Resume parsing
// -----------------------------------------------------------------------------

// Structured output of the resume parser (skills, projects, experience, links).
// Read by the assessment generator and GitHub verifier; the raw file is not stored.
model ParsedResume {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  schemaVersion String   @db.VarChar(20)
  data          Json
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
